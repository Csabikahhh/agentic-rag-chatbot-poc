# Configuration of the agentic RAG chatbot, read by agentic_rag.config.Settings.
#
# Copy this file to .env and change what you need:  cp .env.example .env
# Keep .env in UTF-8. Windows PowerShell 5.1 writes UTF-16 with '>' and Out-File, which the
# settings loader rejects; copy the file there with:  Copy-Item .env.example .env
# Every variable is optional and the values below are the defaults. Real environment
# variables take precedence over .env, and an empty value (KEY=) also means the default.
# Relative paths resolve against the working directory: the repository root when running
# locally, /app in the container.
# Docker Compose and python-dotenv both read this format: keep comments on their own lines.
# Run `agentic-rag config` to print the effective values.

# ---- Chat model ----------------------------------------------------------------------
# Chat model backend: ollama (local Ollama server) or fake (scripted replies, no model).
LLM_PROVIDER=ollama
# URL of the Ollama server; the default reaches an Ollama running on this machine.
OLLAMA_BASE_URL=http://localhost:11434
# Ollama model tag (plan decision 4, chosen by the evaluation and the load test); pull it
# first with `ollama pull`.
OLLAMA_MODEL=qwen3.5:4b
# Context window in tokens (Ollama's num_ctx), 512-131072, sent with every request. The prompt
# and the answer share it, and Ollama silently truncates a prompt that does not fit. A larger
# window needs more GPU memory for the KV cache, for every request Ollama serves in parallel.
OLLAMA_NUM_CTX=8192
# HTTP timeout in seconds for each Ollama request (connecting, sending, every wait for data).
# Keep it generous: Ollama queues concurrent requests and may load the model first.
OLLAMA_TIMEOUT_S=120.0
# Thinking mode of reasoning models such as Qwen3.5: false turns it off, true on. Thinking made
# Qwen3.5-4B about ten times slower in the evaluation, without better answers.
OLLAMA_REASONING=false
# Sampling temperature between 0.0 and 2.0; 0.0 keeps answers as deterministic as possible.
LLM_TEMPERATURE=0.0

# ---- Embeddings ----------------------------------------------------------------------
# Embedding backend: huggingface (sentence-transformers, runs locally) or fake (offline).
EMBEDDING_PROVIDER=huggingface
# Hugging Face model id (provisional choice, plan decision 5); used for indexing and querying.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# ---- Corpus and vector index ---------------------------------------------------------
# Directory with the source corpus.
DATA_DIR=data/raw
# Directory of the persistent Chroma vector index (gitignored).
CHROMA_DIR=data/chroma_db
# Chroma collection name: 3-63 characters from A-Z, a-z, 0-9, dot, underscore and hyphen,
# starting and ending with a letter or digit, with no '..' and not an IPv4 address. The
# 63-character limit is the project's own, stricter than Chroma (512 in chromadb 1.5.9).
CHROMA_COLLECTION=documents

# ---- Retrieval and agent -------------------------------------------------------------
# Maximum relevant chunks kept in the answer context per query (at least 1).
TOP_K=4
# Retrieve a wider candidate pool, fuse vector + keyword rankings, then grade and keep TOP_K.
RETRIEVAL_CANDIDATES=20
# Add local BM25 keyword retrieval and reciprocal-rank fusion; false is vector-only.
HYBRID_SEARCH=true
# Let the chat model drop retrieved chunks that do not help answer the query: true or false.
# One extra LLM call per retrieval; no effect with LLM_PROVIDER=fake.
GRADE_WITH_LLM=true
# Upper bound on the verify -> re-plan loop of the main workflow (0 disables re-planning).
MAX_RETRIES=2

# ---- Start-up and logging ------------------------------------------------------------
# At start-up (agentic-rag serve, the container's command), download the missing corpus
# sources and bring the vector index up to date: true or false.
INGEST_ON_START=true
# Logging level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# ---- Examples ------------------------------------------------------------------------
# Docker Compose: the app container reaches the Ollama service by its service name.
# compose.yaml sets this value for the app service itself; a value in .env does not change it.
# OLLAMA_BASE_URL=http://ollama:11434
#
# Ollama running on the host machine, reached from inside a container. Pass it with
# `docker run --env-file .env`, or with `docker compose run -e` (see compose.yaml):
# OLLAMA_BASE_URL=http://host.docker.internal:11434
#
# Fully offline fake mode (no Ollama, no model downloads), e.g. for tests or UI work:
# LLM_PROVIDER=fake
# EMBEDDING_PROVIDER=fake
